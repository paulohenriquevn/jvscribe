# --- Reference peers: cloned study material, never versioned here ---
# Each folder under references/ is an independent shallow clone with its own .git.
# The catalog (_catalog.md) IS versioned — it is our own bookkeeping.
knowledge-base/references/*
!knowledge-base/references/_catalog.md

# --- Runtime checkpoints written by the implement halt-loop ---
knowledge-base/implementations/.progress-*.json
.compaction-snapshots/
ralph-loop.local.md

# --- Datasets, models, audio: large binaries live outside git ---
data/
datasets/
*.wav
# Fixtures determinísticas SÃO versionadas (T0.1) — o CI não pode depender de rede.
!tests/fixtures/*.wav
*.flac
*.mp3
*.onnx
*.ort
*.pt
*.ckpt
*.bin

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Rust ---
target/

# --- Editors / OS ---
.DS_Store
*.swp

# ONNX Runtime nativo (baixado por scripts/setup_onnxruntime.sh)
vendor/

# Backups/arquivos de modelo comprimidos — NUNCA versionar (pesos são artefato caro e
# irrecuperável; um zip de 1,2 GB no histórico é permanente).
models.zip
*.zip

# Modelo emprestado de M0 (artefato de terceiro, grande) — baixado por scripts/setup_model.sh
models/
*.onnx.data
tmp_*.txt
training/**/*.pt
system-design-output/

# Áudio real de call-center (voz de pessoas reais — LGPD/privacidade, NUNCA versionar)
callcenter/

# Logs de treino volumosos + áudio de eval (evidência fica em resultados .md, não no git)
training/results/**/*train*.log
training/results/**/_eval_wavs/

# Dumps binários de float (features exportadas para eval). A regra é geral, mas a fixture
# GOLDEN do kaldi_fbank É versionada — ela é a âncora do teste de conformidade contra o
# lhotse, e o CI não pode depender de rede para obtê-la.
#
# ORDEM IMPORTA: em .gitignore o último padrão que casa vence. A negação vem DEPOIS da
# regra geral. Antes de M9/T2.1 havia um '*.wav'/'*.f32' repetido no fim do arquivo que
# anulava as exceções lá de cima e deixava as fixtures determinísticas fora do git.
*.f32
!crates/macaw-audio/tests/fixtures/*.f32
